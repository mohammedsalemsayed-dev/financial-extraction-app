# Source control contains only the app and extraction source.
*.pdf
*.xlsx
*.zip
*.log
__pycache__/
_t/
.coverage
archive/financial_extract/session/
uploads/.sessions/

# Editor and operating-system files
.DS_Store
Thumbs.db

# Claude Code session-local state (PID/session-id lock for scheduled
# wakeups) -- not project config, never meant to be shared. .claude/
# launch.json (the dev-server preview config) IS meant to be committed.
.claude/scheduled_tasks.lock

# ESLint + @eslint/js installed on demand at CI/lint time (see
# eslint.config.mjs) -- no package.json/package-lock.json committed either,
# same "resolve it at run time, don't commit it" approach as node_modules
# for any other CI-only tool in this repo. (This comment used to just
# ASSERT that without a rule enforcing it -- an `npm install`/`npm
# uninstall` run locally without --no-save auto-created a bare {} one
# during this project's own development; these two lines exist so that
# can't quietly get committed by accident again.)
node_modules/
package.json
package-lock.json

# `pip install -e .`'s editable-install metadata -- a local build artifact,
# not source (lands next to the source tree regardless of which venv ran
# the install).
*.egg-info/

# Design-canvas mockups: keep the .dc.html sources, skip the seeded/published
# output (a multi-MB copy of the editor payload, not app source).
.design-mockup/*.html
!.design-mockup/*.dc.html

# The two synthetic (fabricated-company) test fixtures ARE committed, unlike
# every real annual report PDF at the repo root (*.pdf above) -- they're
# generated by tablekit_tests/fixtures/generate_fixtures.py, never a real
# company's data, and exist specifically so CI has at least one real,
# non-skipped extraction test instead of only PDF-gated tests that skip
# cleanly with no PDFs present.
!tablekit_tests/fixtures/*.pdf

# FinTabNet.c benchmark dataset (downloaded, ~250MB+ of annotation JSON) and
# its synthesized scratch PDFs -- never commit, just re-download/re-generate
fintabnet/
